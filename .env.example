# ============================================================
# Foundry Agent Playground — environment variables
# Copy to .env.local and fill in real values.
# ============================================================

# Anthropic Claude API key
# Used for streaming chat (claude-sonnet-4-5) and cheap ops (claude-haiku-4-5).
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key
# Used ONLY for text-embedding-3-small (RAG embeddings). Cheap.
OPENAI_API_KEY=sk-...

# Neon Postgres connection string (pooled connection recommended)
# Get this from https://console.neon.tech after enabling the pgvector extension.
DATABASE_URL=postgres://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Public site URL — used for OG image, sitemap, absolute URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: model overrides
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
